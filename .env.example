# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Card import (npm run cards:*) — scripts only, never read by the app
PIXABAY_API_KEY=your-pixabay-key
# Contact (e-mail or URL) sent in the User-Agent, required by Wikimedia APIs
CARD_IMPORT_CONTACT=you@example.com

# Dev only — enables /dev/grants to add cards to your inventory
# ENABLE_DEV_GRANTS=true

# Optional: Stripe (Sprint 8)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OAuth Google and Discord — read by the Supabase CLI only (npx supabase start), local only:
# put them in supabase/.env (git-ignored), never in .env.local. Next never reads them, and they
# never go on Vercel. In production they live in the Supabase dashboard.
# Exporting them in the shell works too. See docs/oauth-providers.md.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
